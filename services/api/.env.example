# Elets PressFlow AI — API configuration (copy to services/api/.env).
# No real secrets here. Every variable is optional for local development unless marked REQUIRED IN PRODUCTION.

# --- core -----------------------------------------------------------------------------------------
ENV=development                      # development | test | production
SECRET_KEY=                          # REQUIRED IN PRODUCTION. Signs session JWTs + OAuth state. Dev: auto-generated into var/dev-secret.key
DATABASE_URL=sqlite:///./var/pressflow.db   # PostgreSQL: postgresql://user:pass@host:5432/db?sslmode=require (Neon/Supabase); needs the [postgres] extra
DATABASE_ECHO=false
FRONTEND_URL=http://localhost:3000   # used for password-reset links and OAuth redirects back to the app
PUBLIC_API_URL=                      # absolute API origin handed to the InDesign bridge + Google redirect (default: request host / http://localhost:8000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- auth -----------------------------------------------------------------------------------------
SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                  # true behind HTTPS
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_BACKEND=log                    # log (dev: reset link written to the server log) | none. E-mail delivery is an integration boundary.
TOKEN_ENCRYPTION_KEY=                # REQUIRED IN PRODUCTION. Fernet key for OAuth tokens at rest:
                                     #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- storage --------------------------------------------------------------------------------------
STORAGE_BACKEND=local                # local | s3 (needs the [s3] extra)
STORAGE_LOCAL_ROOT=./var/storage
S3_BUCKET=                           # default bucket; prefixes videos/ audio/ references/ extracted/ exports/ assets/
S3_BUCKET_VIDEOS=                    # optional per-prefix bucket overrides
S3_BUCKET_AUDIO=
S3_BUCKET_REFERENCES=
S3_BUCKET_EXTRACTED=
S3_BUCKET_EXPORTS=
S3_BUCKET_ASSETS=
S3_ENDPOINT_URL=                     # e.g. http://minio:9000 for MinIO
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=300               # downloads redirect to short-lived presigned URLs

# --- upload limits (MB) ---------------------------------------------------------------------------
MAX_VIDEO_UPLOAD_MB=2048
MAX_REFERENCE_UPLOAD_MB=200
MAX_ASSET_UPLOAD_MB=50

# --- jobs -----------------------------------------------------------------------------------------
RUN_WORKER_INLINE=true               # dev: worker thread inside the API. Production: false + run `python -m app.worker`
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=10          # retry delay = base * 2^(attempt-1)
BRIDGE_JOB_LEASE_SECONDS=2400        # InDesign jobs claimed but not reported within this window are re-queued

# --- LLM ------------------------------------------------------------------------------------------
# Set either key below; you don't need both. LLM_PROVIDER=auto uses OpenAI when OPENAI_API_KEY is set,
# otherwise Anthropic when ANTHROPIC_API_KEY is set. Without a key AI endpoints return 503 (never fake output).
LLM_PROVIDER=auto                    # auto | anthropic | openai_compatible | none
LLM_MODEL=                           # optional override; empty uses the provider default below
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4.1
LLM_EFFORT=high                      # low | medium | high | xhigh | max (Anthropic output_config.effort)
LLM_MAX_TOKENS=32000
LLM_TIMEOUT_SECONDS=600
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                      # also the fallback key for transcription
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_VISION_REFERENCE_ANALYSIS=false  # true: double-check reference page types with a vision-capable model
LLM_ANALYSIS_WINDOW_CHARS=150000     # transcript chars per analysis request

# --- transcription --------------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=none          # openai_compatible | local_whisper (extra: whisper-local) | none
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=               # defaults to OPENAI_API_KEY
TRANSCRIPTION_BASE_URL=              # defaults to OPENAI_BASE_URL
TRANSCRIPTION_CHUNK_SECONDS=600      # audio is split into 64 kbps MP3 chunks below the 25 MB request limit
TRANSCRIPTION_MAX_CHUNK_BYTES=25165824
WHISPER_LOCAL_MODEL=small

# --- AI images -----------------------------------------------------------------------------------
IMAGE_PROVIDER=auto                  # auto: OpenAI /images/generations when OPENAI_API_KEY is set | none
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high                   # low | medium | high | auto (cost scales with quality)

# --- YouTube / Google -----------------------------------------------------------------------------
YOUTUBE_API_KEY=                     # Data API v3 key: duration + caption availability (videos.list)
YOUTUBE_ALLOW_DOWNLOAD=false         # yt-dlp audio download ONLY for recordings the organisation owns/has rights to
GOOGLE_CLIENT_ID=                    # OAuth web client (Drive read + YouTube captions.download for owned videos)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                 # default {PUBLIC_API_URL}/api/v1/integrations/google/callback

# --- tools ----------------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YT_DLP_PATH=yt-dlp
INTEGRATION_NETWORK_CHECKS=true      # integration status performs real (cached) reachability checks
HTTP_TIMEOUT_SECONDS=8

# --- InDesign bridge ------------------------------------------------------------------------------
INDESIGN_BRIDGE_TOKEN=               # shared bearer token used by services/indesign
INDESIGN_BRIDGE_ONLINE_SECONDS=120   # bridge is "online" if a heartbeat arrived within this window

# --- demo -----------------------------------------------------------------------------------------
DEMO_USER_PASSWORD=                  # scripts/seed.py; if empty a random one is written to var/demo-credentials.txt
