{
  "manifestVersion": 5,
  "id": "in.elets.pressflow.indesign",
  "name": "PressFlow Render",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pressflowPanel",
      "label": { "default": "PressFlow" },
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 520 },
      "preferredFloatingSize": { "width": 340, "height": 560 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "plugin"
  }
}
