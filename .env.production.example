# Production values for docker-compose.prod.yml and render.yaml. Copy to .env.production and fill in.
# Never commit the filled-in file (.env.* is ignored by git).

# --- required -------------------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Public origin of the web app, no trailing slash. CORS and reset links are derived from it.
FRONTEND_URL=https://magazine.example.com

# S3-compatible storage for recordings, reference PDFs, pictures and exports.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Leave empty for AWS S3. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# --- who may create an organisation ---------------------------------------------------------------
# Limit sign-up to your own domains, then set ALLOW_SIGNUP=false once the organisation exists.
ALLOW_SIGNUP=true
SIGNUP_ALLOWED_DOMAINS=

# --- optional: AI ----------------------------------------------------------------------------------
# Either key is enough. Without one, generation and AI assistance report "not configured".
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A local or self-hosted OpenAI-compatible server (for example Ollama: http://host:11434/v1) also works here.
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# openai_compatible | none
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=

# --- optional: Google / YouTube --------------------------------------------------------------------
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- optional: InDesign bridge ---------------------------------------------------------------------
# Needed only for native .indd and PDF/X-4. The IDML export works without it.
# PUBLIC_API_URL is the API origin the bridge machine can reach.
PUBLIC_API_URL=
INDESIGN_BRIDGE_TOKEN=

WEB_PORT=3000
