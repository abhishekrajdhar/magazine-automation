# Elets PressFlow AI — environment overview
#
# Each service reads its own file:
#   apps/web/.env.local        ← apps/web/.env.example   (web: only PRESSFLOW_API_URL)
#   services/api/.env          ← services/api/.env.example (API + worker: database, storage, AI providers, Google, InDesign)
#   services/indesign/bridge   ← environment variables documented in services/indesign/README.md
#
# Never put API keys in the web app. The browser calls /api/v1 on its own origin and
# Next.js proxies to PRESSFLOW_API_URL server-side.

# --- web ---
PRESSFLOW_API_URL=http://localhost:8000

# --- api (see services/api/.env.example for the full list) ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./var/pressflow.db
STORAGE_BACKEND=local
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
INDESIGN_BRIDGE_TOKEN=

# --- indesign bridge (on the InDesign machine) ---
# PRESSFLOW_API_URL=https://api.example.com
# INDESIGN_BRIDGE_TOKEN=<same as the API>
# INDESIGN_MODE=desktop
